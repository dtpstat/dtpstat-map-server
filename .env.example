# Runtime
NODE_ENV=development
# For direct/local access use 0.0.0.0 as needed. In production behind a local
# nginx reverse proxy, binding Node to 127.0.0.1 reduces unnecessary exposure.
HOST=0.0.0.0

# HTTP can run alone or together with HTTPS. PORT is accepted as an alias for HTTP_PORT.
HTTP_ENABLED=true
HTTP_PORT=3000
# Number of trusted reverse-proxy hops before Node.
# Keep 0 when Node is reached directly.
# Set 1 for the usual single trusted nginx/Apache proxy. This is required not
# only for the real client IP/audit/IP lockout, but also so Express sees the
# original HTTPS protocol from X-Forwarded-Proto and the session-CSRF Origin
# check does not reject legitimate proxied admin mutations.
# A trusted proxy should pass Host, X-Forwarded-Proto and X-Forwarded-For.
HTTP_TRUST_PROXY_HOPS=0

# To enable HTTPS directly in Node, provide readable PEM files.
HTTPS_ENABLED=false
HTTPS_PORT=3443
HTTPS_KEY_PATH=./certificates/localhost-key.pem
HTTPS_CERT_PATH=./certificates/localhost-cert.pem

# Application database. Runtime server, migrations, maintenance tasks and
# imports use this role.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=map_server
DATABASE_ROLE=map_server_app
DATABASE_ROLE_PASSWORD=replace-with-a-long-random-database-password
# SQL schema and technical instance namespace. Use a distinct lower-case value
# for a cloned deployment (for example tramlanes). Existing installs default to
# buslanes when this variable is omitted. Runtime SQL resolves tables through
# search_path=<DATABASE_SCHEMA>,public and must not hardcode buslanes.<table>.
DATABASE_SCHEMA=buslanes
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# PostgreSQL superuser credentials used only by `npm run db:init`.
POSTGRES_ADMIN_DATABASE=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-the-postgres-admin-password

# Bootstrap/recovery administrator credentials.
# When ADMIN_USERS is empty, the first server startup creates one bootstrap
# superuser from these values with all administrative permissions.
# Once any ADMIN_USERS row exists, these values are NOT an online-login fallback
# and changing them does not modify the existing DB user.
# They may be removed after bootstrap, or intentionally kept as the source for
# `npm run admin:set-superuser` emergency recovery.
IMPORT_API_USERNAME=admin
IMPORT_API_PASSWORD=replace-with-a-long-random-password

# Maximum decoded body size for large protected imports.
# If nginx/Apache is in front of Node, its request-body limit must be >= this
# value. For the default 25 MiB value, nginx `client_max_body_size 30m;` leaves a
# small margin and avoids proxy-generated HTTP 413 before the request reaches Node.
IMPORT_API_MAX_BODY_BYTES=26214400

# Protected POST /api/admin/update/cities. First loads IDs of all Russian
# named way/relation place=city/town objects, then loads geometry batches
# sequentially. The request batchSize may not exceed MAX_BATCH_SIZE.
OSM_CITY_UPDATE_URL=https://overpass-api.de/api/interpreter
OSM_CITY_UPDATE_ALLOWED_HOSTS=overpass-api.de,overpass.kumi.systems,overpass.private.coffee,maps.mail.ru
OSM_CITY_UPDATE_ALLOWED_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
OSM_CITY_UPDATE_TIMEOUT_MS=600000
OSM_CITY_UPDATE_QUERY_TIMEOUT_SECONDS=300
# Default N and hard API upper bound for one geometry request.
OSM_CITY_UPDATE_BATCH_SIZE=50
OSM_CITY_UPDATE_MAX_BATCH_SIZE=200
# Keep public Overpass requests sequential and retry the same request on
# temporary HTTP 429/502/503/504 responses.
OSM_CITY_UPDATE_MIN_DELAY_MS=5000
OSM_CITY_UPDATE_MAX_RETRIES=6
OSM_CITY_UPDATE_RETRY_BASE_DELAY_MS=30000
OSM_CITY_UPDATE_RETRY_MAX_DELAY_MS=240000
# Empty uses "<DATABASE_SCHEMA>/2.0 OSM city updater".
OSM_CITY_UPDATE_USER_AGENT=
# Total byte budget for the ID response and every geometry batch combined.
OSM_CITY_UPDATE_MAX_BYTES=314572800
OSM_CITY_UPDATE_REQUEST_MAX_BODY_BYTES=16384
OSM_CITY_UPDATE_DRY_RUN=false

# Protected POST /api/admin/update. A request JSON array replaces these sources.
# Each layer explicitly sets the direction multiplier: 1=one-way, 2=two-way.
# `type` is the imported/source LINE_TYPES.NAME, not numeric CODE. NAME is
# matched ignoring case and outer spaces. Missing NAME is created automatically;
# the database generates CODE and initial TITLE equals NAME.
KML_UPDATE_SOURCES_JSON=[{"URL":"https://www.google.com/maps/d/viewer?mid=1GO7k2n2_8FgvzaaZCKtRhVCPr5s","layers":[{"name":"Существующие","multiple":2,"type":"Двусторонние"},{"name":"Существующие. Односторонние","multiple":1,"type":"Односторонние"}]},{"URL":"https://www.google.com/maps/d/viewer?mid=1PWvRWfdKEV4SVs5ONkDgRPLbRiQ","layers":[{"name":"двусторонние сущ.","multiple":2,"type":"Двусторонние"},{"name":"односторонние сущ.","multiple":1,"type":"Односторонние"}]}]
KML_UPDATE_ALLOWED_HOSTS=www.google.com
KML_UPDATE_MAX_SOURCES=10
KML_UPDATE_TIMEOUT_MS=30000
KML_UPDATE_MAX_FILE_BYTES=10485760
KML_UPDATE_MAX_TOTAL_BYTES=52428800
KML_UPDATE_REQUEST_MAX_BODY_BYTES=262144
KML_UPDATE_DRY_RUN=false
# Matching uses actual OSM polygons. The optional geodesic buffer is in metres;
# request query cityBufferMeters cannot exceed the configured maximum.
KML_UPDATE_CITY_BUFFER_METERS=0
KML_UPDATE_CITY_BUFFER_MAX_METERS=5000
KML_UPDATE_UNMATCHED_POLICY=skip
KML_UPDATE_AMBIGUOUS_POLICY=best-overlap

# Mapbox public access token bootstrap. Starting with V019, the first startup
# that finds PROJECT_SETTINGS.MAPBOX_ACCESS_TOKEN_INITIALIZED=false copies this
# pk.* value into PostgreSQL. After that the DB value is authoritative and this
# variable is ignored even if it remains in .env; it may therefore be removed.
# Further token changes are made in Admin -> Interface settings -> Project or by
# a versioned project-settings transfer package.
MAPBOX_ACCESS_TOKEN=pk.replace-with-your-public-mapbox-token
# Style URL remains a deployment/runtime setting and is not part of project-settings transfer.
MAPBOX_STYLE_URL=mapbox://styles/culebron/cj7ornxjab8oq2spdw84gxob0
