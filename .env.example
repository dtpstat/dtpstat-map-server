# Runtime
NODE_ENV=development
HOST=0.0.0.0

# HTTP can run alone or together with HTTPS. PORT is accepted as an alias for HTTP_PORT.
HTTP_ENABLED=true
HTTP_PORT=3000

# To enable HTTPS, provide readable PEM files.
HTTPS_ENABLED=false
HTTPS_PORT=3443
HTTPS_KEY_PATH=./certificates/localhost-key.pem
HTTPS_CERT_PATH=./certificates/localhost-cert.pem

# Application database. Server, migrations, and imports use only this role.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=dtpstat_buslines
DATABASE_ROLE=dtpstat_buslines_app
DATABASE_ROLE_PASSWORD=replace-with-a-long-random-database-password
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Superuser credentials used only by `npm run db:init`.
POSTGRES_ADMIN_DATABASE=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-the-postgres-admin-password

# Shared Basic Auth for /admin/, every /api/admin/* route, and /api/admin/ws.
# Use HTTPS and a long password outside a trusted local network.
IMPORT_API_USERNAME=admin
IMPORT_API_PASSWORD=replace-with-a-long-random-password
IMPORT_API_MAX_BODY_BYTES=26214400

# Protected POST /api/admin/update/cities. First loads IDs of all Russian
# named way/relation place=city/town objects, then loads geometry batches
# sequentially. The request batchSize may not exceed MAX_BATCH_SIZE.
OSM_CITY_UPDATE_URL=https://overpass-api.de/api/interpreter
OSM_CITY_UPDATE_ALLOWED_HOSTS=overpass-api.de,overpass.kumi.systems,maps.mail.ru
OSM_CITY_UPDATE_TIMEOUT_MS=600000
OSM_CITY_UPDATE_QUERY_TIMEOUT_SECONDS=300
# Default N and hard API upper bound for one geometry request.
OSM_CITY_UPDATE_BATCH_SIZE=50
OSM_CITY_UPDATE_MAX_BATCH_SIZE=200
# Total byte budget for the ID response and every geometry batch combined.
OSM_CITY_UPDATE_MAX_BYTES=314572800
OSM_CITY_UPDATE_REQUEST_MAX_BODY_BYTES=16384
OSM_CITY_UPDATE_DRY_RUN=false

# Protected POST /api/admin/update. A request JSON array replaces these sources.
# Each layer explicitly sets the direction multiplier: 1=one-way, 2=two-way.
KML_UPDATE_SOURCES_JSON=[{"URL":"https://www.google.com/maps/d/viewer?mid=1GO7k2n2_8FgvzaaZCKtRhVCPr5s","layers":[{"name":"Существующие","multiple":2},{"name":"Существующие. Односторонние","multiple":1}]},{"URL":"https://www.google.com/maps/d/viewer?mid=1PWvRWfdKEV4SVs5ONkDgRPLbRiQ","layers":[{"name":"двусторонние сущ.","multiple":2},{"name":"односторонние сущ.","multiple":1}]}]
KML_UPDATE_ALLOWED_HOSTS=www.google.com
KML_UPDATE_MAX_SOURCES=10
KML_UPDATE_TIMEOUT_MS=30000
KML_UPDATE_MAX_FILE_BYTES=10485760
KML_UPDATE_MAX_TOTAL_BYTES=52428800
KML_UPDATE_REQUEST_MAX_BODY_BYTES=262144
KML_UPDATE_DRY_RUN=false
# Matching uses actual OSM polygons. The optional geodesic buffer is in metres;
# request query cityBufferMeters cannot exceed the configured maximum.
KML_UPDATE_CITY_BUFFER_METERS=0
KML_UPDATE_CITY_BUFFER_MAX_METERS=5000
KML_UPDATE_UNMATCHED_POLICY=skip
KML_UPDATE_AMBIGUOUS_POLICY=best-overlap

# Public Mapbox settings returned to the browser by GET /api/config.
MAPBOX_ACCESS_TOKEN=pk.replace-with-your-public-mapbox-token
MAPBOX_STYLE_URL=mapbox://styles/culebron/cj7ornxjab8oq2spdw84gxob0
