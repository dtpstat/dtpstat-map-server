# Runtime
NODE_ENV=development
# For direct/local access use 0.0.0.0 as needed. In production behind a local
# nginx reverse proxy, binding Node to 127.0.0.1 reduces unnecessary exposure.
HOST=0.0.0.0

# HTTP can run alone or together with HTTPS. PORT is accepted as an alias for HTTP_PORT.
HTTP_ENABLED=true
HTTP_PORT=3000
# Number of trusted reverse-proxy hops before Node.
# Keep 0 when Node is reached directly. Set 1 for the usual single trusted
# nginx/Apache proxy. The proxy must pass Host, X-Forwarded-Proto and
# X-Forwarded-For so session-CSRF, audit and IP protection see the client request.
HTTP_TRUST_PROXY_HOPS=0

# To enable HTTPS directly in Node, provide readable PEM files.
HTTPS_ENABLED=false
HTTPS_PORT=3443
HTTPS_KEY_PATH=./certificates/localhost-key.pem
HTTPS_CERT_PATH=./certificates/localhost-cert.pem

# Application database. Runtime server, migrations, maintenance tasks and
# imports use this role.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=map_server
DATABASE_ROLE=map_server_app
DATABASE_ROLE_PASSWORD=replace-with-a-long-random-database-password
# SQL schema and technical instance namespace. Use a distinct lower-case value
# for cloned deployments (for example tramlanes). Existing legacy installs
# default to buslanes when this variable is omitted. Runtime SQL resolves tables
# through search_path=<DATABASE_SCHEMA>,public.
DATABASE_SCHEMA=buslanes
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# PostgreSQL superuser credentials used only by `npm run db:init`.
POSTGRES_ADMIN_DATABASE=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-the-postgres-admin-password

# Bootstrap/recovery administrator credentials.
# When ADMIN_USERS is empty, the first server startup creates one bootstrap
# superuser from these values. Once DB users exist these values are NOT an
# online-login fallback and may be removed or kept only for recovery tooling.
IMPORT_API_USERNAME=admin
IMPORT_API_PASSWORD=replace-with-a-long-random-password

# Maximum decoded body size for large protected imports.
# For this default 25 MiB value, nginx `client_max_body_size 30m;` leaves margin.
IMPORT_API_MAX_BODY_BYTES=26214400

# OSM city/town boundaries. The updater loads Russian named way/relation
# place=city/town objects in sequential geometry batches. V023 later merges
# relation fragments sharing PLACE_TYPE + logical FULL_NAME into one boundary.
OSM_CITY_UPDATE_URL=https://overpass-api.de/api/interpreter
OSM_CITY_UPDATE_ALLOWED_HOSTS=overpass-api.de,overpass.kumi.systems,overpass.private.coffee,maps.mail.ru
OSM_CITY_UPDATE_ALLOWED_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
OSM_CITY_UPDATE_TIMEOUT_MS=600000
OSM_CITY_UPDATE_QUERY_TIMEOUT_SECONDS=300
OSM_CITY_UPDATE_BATCH_SIZE=50
OSM_CITY_UPDATE_MAX_BATCH_SIZE=200
# Public Overpass requests are sequential. Retry the same request on temporary
# HTTP 429/502/503/504 responses.
OSM_CITY_UPDATE_MIN_DELAY_MS=5000
OSM_CITY_UPDATE_MAX_RETRIES=6
OSM_CITY_UPDATE_RETRY_BASE_DELAY_MS=30000
OSM_CITY_UPDATE_RETRY_MAX_DELAY_MS=240000
# Empty uses "<DATABASE_SCHEMA>/2.0 OSM city updater".
OSM_CITY_UPDATE_USER_AGENT=
# Total byte budget for the ID response and geometry batches combined.
OSM_CITY_UPDATE_MAX_BYTES=314572800
OSM_CITY_UPDATE_REQUEST_MAX_BODY_BYTES=16384
OSM_CITY_UPDATE_DRY_RUN=false

# Optional default sources for protected POST /api/admin/update.
# Leave empty on a fresh/generic deployment and supply sources from the admin UI.
# Format example:
# [{"URL":"https://www.google.com/maps/d/viewer?mid=...","layers":[{"name":"Layer","multiple":1,"type":"Type name"}]}]
# `type` is LINE_TYPES.NAME; missing names are created automatically.
KML_UPDATE_SOURCES_JSON=
KML_UPDATE_ALLOWED_HOSTS=www.google.com
KML_UPDATE_MAX_SOURCES=10
KML_UPDATE_TIMEOUT_MS=30000
KML_UPDATE_MAX_FILE_BYTES=10485760
KML_UPDATE_MAX_TOTAL_BYTES=52428800
KML_UPDATE_REQUEST_MAX_BODY_BYTES=262144
KML_UPDATE_DRY_RUN=false
# Matching uses actual OSM polygons. Optional geodesic buffer is in metres.
KML_UPDATE_CITY_BUFFER_METERS=0
KML_UPDATE_CITY_BUFFER_MAX_METERS=5000
KML_UPDATE_UNMATCHED_POLICY=skip
KML_UPDATE_AMBIGUOUS_POLICY=best-overlap

# Mapbox public access-token bootstrap. Starting with V019, the first startup
# with PROJECT_SETTINGS.MAPBOX_ACCESS_TOKEN_INITIALIZED=false copies this pk.*
# value into PostgreSQL. After initialization DB is authoritative; the ENV value
# may be removed. On an already initialized instance this variable is optional.
MAPBOX_ACCESS_TOKEN=pk.replace-with-your-public-mapbox-token
# Style URL remains deployment/runtime configuration and is not transferred by
# project-settings package. Use an explicit project style here when needed.
MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12
