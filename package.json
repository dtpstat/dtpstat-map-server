{
  "name": "dtpstat-map-server",
  "version": "2.0.0",
  "private": true,
  "description": "Interactive geospatial line map backed by PostgreSQL and PostGIS",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-database.js",
    "db:migrate": "node scripts/migrate.js",
    "db:import": "node scripts/import-data.js",
    "admin:unblock": "node scripts/unblock-admin.js",
    "admin:set-superuser": "node scripts/set-superuser-credentials.js",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.1.0",
    "mapbox-gl": "^3.15.0",
    "pg": "^8.16.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "globals": "^16.3.0"
  }
}
